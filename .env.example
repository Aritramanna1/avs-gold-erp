# AVS Gold ERP — build-time environment template
# Copy to .env only for development/build infrastructure.
# NEVER commit a populated .env to version control.

# Central Arivahly Licensing API. Customers never edit this value.
VITE_LICENSE_ENDPOINT="https://licenses.arivahly.in/v1/validate"
# Base64url-encoded raw Ed25519 public key. The signing private key stays on the API.
VITE_LICENSE_ED25519_PUBLIC_KEY="REPLACE_WITH_PUBLIC_KEY"

# Optional developer defaults. Customer Hybrid credentials are entered during setup.
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="PROJECT_REF"

# VITE_DEPLOYMENT_MODES_ENABLED=true
