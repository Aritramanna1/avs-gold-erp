# AVS Gold ERP — build-time environment template
# Copy to .env only for development/build infrastructure.
# NEVER commit a populated .env to version control.

# Central Arivahly Licensing API. Customers never edit this value.
VITE_LICENSE_ENDPOINT="https://licenses.arivahly.in/v1/validate"
# Base64url-encoded raw Ed25519 public key. The signing private key stays on the API.
VITE_LICENSE_ED25519_PUBLIC_KEY="REPLACE_WITH_PUBLIC_KEY"

# Optional developer defaults. Customer Hybrid credentials are entered during setup.
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="PROJECT_REF"

# Owner-only: set in your local shell (NOT in committed .env.local) to allow npm run dev
# against a live Supabase project. Without this, dev is blocked when URL points at production.
# VITE_ENABLE_DEV_SUPABASE=1

VITE_R2_PROXY_URL="https://mtj-storage-proxy.<cloudflare-account>.workers.dev"

# staging | test — shows STAGING badge in UI. Never set on production builds.
# VITE_APP_ENV=staging

# Set to true only when Supabase Google provider + callback URLs are configured for this environment.
# Staging deploy script sets this automatically. See docs/GOOGLE_OAUTH_STAGING.md.
# VITE_GOOGLE_OAUTH_ENABLED=true

# VITE_DEPLOYMENT_MODES_ENABLED=true
VITE_FORCE_ONLINE=false

# Web deployment (maatarajewellers.shop): force Supabase-only mode, no sql.js/
# offline wizard. Required for the browser production build.
VITE_DEFAULT_DEPLOYMENT_MODE=online

# Meta WhatsApp Cloud API (Embedded Signup + template sync)
VITE_META_APP_ID="REPLACE_WITH_META_APP_ID"
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID="REPLACE_WITH_EMBEDDED_SIGNUP_CONFIG_ID"
# Razorpay — set in Supabase Edge Function secrets OR Platform Owner → Settings → Razorpay
# RAZORPAY_KEY_ID=rzp_test_REPLACE
# RAZORPAY_KEY_SECRET=REPLACE
# RAZORPAY_WEBHOOK_SECRET=whsec_REPLACE

# Optional free tawk.to chat (AVS-52). Leave unset to disable.
# VITE_TAWK_PROPERTY_ID=
# VITE_TAWK_WIDGET_ID=default

# Hostinger SMTP (AUTH-MAIL / EM-01) — values in local .env / Hostinger secrets only
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_USER=projects@arivahly.in
# SMTP_PASS=
# SMTP_FROM_EMAIL=projects@arivahly.in
# SMTP_FROM_NAME=Arivahly Projects
