# Copy to qa/security/strix/accounts.env (gitignored) — TEST/STAGING QA accounts only
# Tenant A (primary — from .env.e2e or dedicated QA seed)
QA_TENANT_A_FIRM_ID=
QA_OWNER_A_EMAIL=
QA_OWNER_A_PASSWORD=
QA_ADMIN_A_EMAIL=
QA_ADMIN_A_PASSWORD=
QA_MANAGER_A_EMAIL=
QA_MANAGER_A_PASSWORD=
QA_KARIGAR_A_EMAIL=
QA_KARIGAR_A_PASSWORD=
QA_CUSTOMER_A_EMAIL=
QA_CUSTOMER_A_PASSWORD=
QA_SUPPLIER_A_EMAIL=
QA_SUPPLIER_A_PASSWORD=

# Tenant B (isolation negative tests — required for cross-tenant Strix checks)
QA_TENANT_B_FIRM_ID=
QA_OWNER_B_EMAIL=
QA_OWNER_B_PASSWORD=
QA_KARIGAR_B_EMAIL=
QA_KARIGAR_B_PASSWORD=
QA_CUSTOMER_B_EMAIL=
QA_CUSTOMER_B_PASSWORD=
QA_SUPPLIER_B_EMAIL=
QA_SUPPLIER_B_PASSWORD=

# Supabase staging (anon key only — NEVER service role in Strix env)
QA_SUPABASE_URL=
QA_SUPABASE_ANON_KEY=

# Razorpay TEST MODE only
RAZORPAY_KEY_ID=rzp_test_REPLACE
# Do not set live keys. Webhook secret for signature tests only:
RAZORPAY_WEBHOOK_SECRET=whsec_REPLACE
