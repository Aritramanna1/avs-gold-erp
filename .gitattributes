# Normalize line endings to LF for all text files, regardless of the
# checking-out platform's core.autocrlf setting. This is the root cause of
# the ~18,900 "Delete `\r`" prettier/prettier lint errors seen on Windows
# checkouts: core.autocrlf=true converts LF -> CRLF on checkout while
# Prettier's default endOfLine is "lf" — the two disagree on every line.
* text=auto eol=lf

# Binary assets — never touched by line-ending normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.db binary
*.sqlite binary
