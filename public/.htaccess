# ==============================================================================
# MTJ / AVS ERP — Hostinger Production Apache Configuration (.htaccess)
# ==============================================================================

# Prevent directory indexing
Options -Indexes

# Follow symlinks
Options +FollowSymLinks

# Security & Privacy Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Prevent caching of API and dynamic JSON responses
<LocationMatch "^/api/">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</LocationMatch>

# Static Asset Caching for immutable bundles
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# SPA Routing & API Handling
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to API PHP endpoints
    RewriteRule ^api/ - [L]

    # Serve existing static files & directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all SPA frontend paths to index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Block executable scripts inside uploads directory
<Directory "uploads">
    <FilesMatch "\.(php|phtml|php5|php7|php8|sh|exe|pl|cgi)$">
        Require all denied
    </FilesMatch>
</Directory>

# Block access to hidden and sensitive files (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
