DirectoryIndex index.html

# sql.js uses the WASM binary during boot. Serve it with the correct MIME so
# browsers can use streaming compilation instead of logging a fallback error.
AddType application/wasm .wasm

# Vite/TanStack Router SPA fallback for Apache/Hostinger.
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Never cache authenticated application HTML.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
