# ==============================================================================
# MTJ / AVS ERP — Hostinger Production Apache Configuration (.htaccess)
# ==============================================================================

# Prevent directory indexing
Options -Indexes

# Follow symlinks
Options +FollowSymLinks

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# SPA Routing & API Handling
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to API PHP endpoints
    RewriteRule ^api/ - [L]

    # Serve existing static files & directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all SPA frontend paths to index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Block executable scripts inside uploads directory
<Directory "uploads">
    <FilesMatch "\.(php|phtml|php5|php7|php8|sh|exe|pl|cgi)$">
        Require all denied
    </FilesMatch>
</Directory>

# Block access to hidden and sensitive files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
